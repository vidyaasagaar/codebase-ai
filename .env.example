# Copy to .env.local and fill in. Any OpenAI-compatible Chat Completions endpoint works.

# OpenRouter (default)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=

# Gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=
# LLM_MODEL=gemini-2.5-flash

# Groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# Max characters of retrieved code sent to the LLM per question (lower for small rate limits).
# MAX_CONTEXT_CHARS=24000

# Optional GitHub token (no scopes needed for public repos): raises GitHub API limits
# from 60 requests/hour and 10 searches/minute.
# GITHUB_TOKEN=

# GitHub sign-in for private and organization repositories (GitHub App with read-only permissions — see README).
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
# GITHUB_APP_SLUG=your-app-slug

# Optional: key used to encrypt stored GitHub tokens (defaults to a random key generated into .data/secret.key).
# CODEBASE_AI_SECRET=

# Public URL of this deployment, used for canonical links, the sitemap and link previews.
# NEXT_PUBLIC_SITE_URL=https://codebaseee.netlify.app

# Capabilities are auto-detected: serverless hosts (Netlify, Vercel) run as a read-only preview without indexing.
# Force with "full" (indexing enabled) or "hosted" (preview only).
# CODEBASE_AI_MODE=
